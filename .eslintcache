te management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  44 |     function () {\n  45 |       // eslint-disable-next-line react-hooks/set-state-in-effect\n> 46 |       setEmail(email => ({ ...email, value: paramEmail || \"\" }));\n     |       ^^^^^^^^ Avoid calling setState() directly within an effect\n  47 |     },\n  48 |     [paramEmail],\n  49 |   );",["409"],"'NoAuthPage' is defined but never used.",["410"],["411"],"'useParams' is defined but never used.",["412"],"react-refresh/only-export-components","Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","namedExport",["413"],"'isLoading' is assigned a value but never used.",["414"],["415"],["416"],"'useState' is defined but never used.",["417"],{"messageId":"418","data":"419","fix":"420","desc":"421"},{"messageId":"418","data":"422","fix":"423","desc":"421"},{"messageId":"418","data":"424","fix":"425","desc":"421"},{"messageId":"418","data":"426","fix":"427","desc":"428"},{"kind":"429","justification":"430"},{"messageId":"418","data":"431","fix":"432","desc":"433"},{"messageId":"418","data":"434","fix":"435","desc":"421"},{"messageId":"418","data":"436","fix":"437","desc":"438"},{"kind":"429","justification":"430"},{"messageId":"418","data":"439","fix":"440","desc":"441"},{"messageId":"418","data":"442","fix":"443","desc":"441"},{"kind":"429","justification":"430"},{"messageId":"418","data":"444","fix":"445","desc":"446"},"removeVar",{"varName":"447"},{"range":"448","text":"430"},"Remove unused variable 'styles'.",{"varName":"447"},{"range":"449","text":"430"},{"varName":"447"},{"range":"450","text":"430"},{"varName":"451"},{"range":"452","text":"430"},"Remove unused variable 'useLocation'.","directive","",{"varName":"453"},{"range":"454","text":"430"},"Remove unused variable 'NoAuthPage'.",{"varName":"447"},{"range":"455","text":"430"},{"varName":"456"},{"range":"457","text":"430"},"Remove unused variable 'useParams'.",{"varName":"458"},{"range":"459","text":"430"},"Remove unused variable 'isLoading'.",{"varName":"458"},{"range":"460","text":"430"},{"varName":"461"},{"range":"462","text":"430"},"Remove unused variable 'useState'.","styles",[7,19],[7,19],[7,19],"useLocation",[158,170],"NoAuthPage",[143,159],[53,65],"useParams",[141,152],"isLoading",[272,293],[272,293],"useState",[28,38]]